{% extends 'layouts/admin.twig' %}

{% block title %}
	{{ t('admin.dashboard_title') }}
{% endblock %}

{% block content %}

	{# ── Hlavička + export ── #}
	<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
		<div>
			<h1 class="text-2xl font-bold text-brand-900">
				{{ t('admin.dashboard_title') }}
			</h1>
			<p class="text-sm text-brand-500 mt-1">
				{{ t('admin.total') }}:
				<strong>{{ total }}</strong>
			</p>
		</div>

		<div>

			{# Export — respektuje aktuální filtr #}
			<a href="{{ base_path }}/admin/export" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700
									          text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
				📥
				{% if current_locale() == 'cs' %}Export REGISTRACÍ{% else %}Export REGISTRATIONS
				{% endif %}
			</a>

			<a href="{{ base_path }}/admin/export-festivals{% if selected_festival %}?festival={{ selected_festival }}{% endif %}" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700
									          text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
				📥
				{% if current_locale() == 'cs' %}Export FESTIVALŮ{% else %}Export FESTIVALS
				{% endif %}
			</a>
		</div>
	</div>

	{# ── Filtr dle festivalu ── #}
	<div class="bg-white rounded-xl border border-brand-200 p-4 mb-6">
		<form method="GET" action="{{ base_path }}/admin/" class="flex flex-col sm:flex-row gap-3 items-end">
			<div class="flex-1">
				<label class="block text-xs font-semibold text-[#743a25] mb-1">
					{{ t('admin.filter_festival') }}
				</label>
				<select name="festival" class="w-full rounded-lg border border-brand-300 px-3 py-2
																		                           text-sm focus:outline-none focus:ring-2 focus:ring-[#d96e45]">
					<option value="">{{ t('admin.filter_all') }}</option>
					{% for festival in festivals %}
						<option value="{{ festival.id }}" {% if selected_festival == festival.id %} selected {% endif %}>
							{{ festival.name }}
							—
							{{ festival.city }}
							({{ festival.date|date('d. m. Y') }})
						</option>
					{% endfor %}
				</select>
			</div>
			<button type="submit" class="bg-[#743a25] hover:bg-[#5e2e1c] text-white text-sm
															                       font-semibold px-5 py-2 rounded-lg transition-colors">
				{{ t('admin.filter_btn') }}
			</button>
			{% if selected_festival %}
				<a href="{{ base_path }}/admin/" class="text-sm text-brand-500 hover:text-[#5e2e1c] py-2 px-2">
					✕ Reset
				</a>
			{% endif %}
		</form>
	</div>

	{# ── Tabulka ── #}
	<div class="bg-white rounded-xl border border-brand-200 overflow-hidden shadow-sm">
		{% if exhibitors|length > 0 %}
			<div class="overflow-x-auto">
				<table
					class="min-w-full text-sm">
					{# Záhlaví tabulky #}
					<thead class="bg-[#743a25] text-white text-sm uppercase tracking-wide">
						<tr>
							<th class="px-4 py-3 text-left">{{ t('admin.col_id') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_company') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_contact') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_email') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_phone') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_festivals') }}</th>
							<th class="px-4 py-3 text-left">{{ t('admin.col_created') }}</th>
							<th class="px-4 py-3 text-right">{{ t('admin.col_price') }}</th>
                                   <th class="px-4 py-3 text-center">Detail</th>
						</tr>
					</thead>

					{# Řádky #}
                         <tbody class="divide-y divide-gray-100" x-data="{ expanded: null }">
                              {% set grandTotal = 0 %}
                              {% for ex in exhibitors %}
                                   {% set grandTotal = grandTotal + ex.total_price %}

                                   {# Hlavní řádek #}
                                   <tr class="hover:bg-[#fdf5f2] transition-colors cursor-pointer
                                             {% if loop.index is even %}bg-gray-50{% endif %}"
                                        @click="expanded === '{{ ex.id }}' ? expanded = null : expanded = '{{ ex.id }}'">
                                        <td class="px-4 py-3 text-gray-400 font-mono text-sm">#{{ ex.id }}</td>
                                        <td class="px-4 py-3">
                                             <div class="font-semibold text-gray-900">{{ ex.company }}</div>
                                             {% if ex.ico %}
                                             <div class="text-xs text-gray-400">IČ: {{ ex.ico }}</div>
                                             {% endif %}
                                        </td>
                                        <td class="px-4 py-3 text-gray-700">{{ ex.contact_name }}</td>
                                        <td class="px-4 py-3">
                                             <a href="mailto:{{ ex.email }}"
                                             class="text-[#743a25] hover:underline"
                                             @click.stop>{{ ex.email }}</a>
                                        </td>
                                        <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{{ ex.phone }}</td>
                                        <td class="px-4 py-3">
                                             {% if ex.festival_ids %}
                                                  {% for fid in ex.festival_ids|split(',') %}
                                                  {% for f in festivals %}
                                                       {% if f.id == fid|trim|number_format(0,'','') %}
                                                       <span class="inline-block bg-[#f9e4db] text-[#743a25]
                                                                      text-xs px-2 py-0.5 rounded-full mb-1">
                                                            {{ f.city }}
                                                       </span>
                                                       {% endif %}
                                                  {% endfor %}
                                                  {% endfor %}
                                             {% endif %}
                                        </td>
                                        <td class="px-4 py-3 text-right font-semibold text-[#743a25] whitespace-nowrap">
                                             {% if ex.total_price > 0 %}
                                                  {{ ex.total_price|number_format(0, ',', '.') }} Kč
                                             {% else %}—{% endif %}
                                        </td>
                                        <td class="px-4 py-3 text-gray-500 text-xs whitespace-nowrap">
                                             {{ ex.created_at|date('d. m. Y H:i') }}
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                             <button @click.stop="expanded === '{{ ex.id }}' ? expanded = null : expanded = '{{ ex.id }}'"
                                                       :class="expanded === '{{ ex.id }}'
                                                            ? 'bg-[#743a25] text-white border-[#743a25]'
                                                            : 'text-[#743a25] border-[#743a25] hover:bg-[#fdf5f2]'">
                                                  <span x-show="expanded !== '{{ ex.id }}'">▼ Detail</span>
                                                  <span x-show="expanded === '{{ ex.id }}'">▲ Zavřít</span>
                                             </button>
                                        </td>
                                   </tr>

                                   {# Detail řádek #}
                                   <tr x-show="expanded === '{{ ex.id }}'"
                                        x-transition:enter="transition ease-out duration-200"
                                        x-transition:enter-start="opacity-0"
                                        x-transition:enter-end="opacity-100"
                                        class="bg-[#fdf5f2]">
                                        <td colspan="9" class="px-6 py-5">
                                             <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">

                                                  {# Kontaktní údaje #}
                                                  <div>
                                                  <h4 class="font-bold text-[#743a25] uppercase tracking-wide text-xs mb-3">
                                                       Kontaktní údaje
                                                  </h4>
                                                  <table class="w-full text-sm">
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">IČ</td>
                                                            <td class="font-medium text-gray-800">{{ ex.ico ?? '—' }}</td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">DIČ</td>
                                                            <td class="font-medium text-gray-800">{{ ex.dic ?? '—' }}</td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Firma</td>
                                                            <td class="font-medium text-gray-800">{{ ex.company }}</td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Adresa</td>
                                                            <td class="font-medium text-gray-800">{{ ex.address }}</td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Kontakt</td>
                                                            <td class="font-medium text-gray-800">{{ ex.contact_name }}</td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">E-mail</td>
                                                            <td>
                                                                 <a href="mailto:{{ ex.email }}"
                                                                 class="text-[#743a25] hover:underline">
                                                                      {{ ex.email }}
                                                                 </a>
                                                            </td>
                                                       </tr>
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Telefon</td>
                                                            <td class="font-medium text-gray-800">{{ ex.phone }}</td>
                                                       </tr>
                                                       {% if ex.website %}
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Web</td>
                                                            <td>
                                                                 {# Doplň schéma — bez něj se odkaz bere jako relativní #}
                                                                 {% set web = ex.website|trim %}
                                                                 {% set web_url = (web|lower starts with 'http://' or web|lower starts with 'https://')
                                                                      ? web : 'https://' ~ web %}
                                                                 <a href="{{ web_url }}" target="_blank" rel="noopener noreferrer"
                                                                 class="text-[#743a25] hover:underline">
                                                                      {{ web }}
                                                                 </a>
                                                            </td>
                                                       </tr>
                                                       {% endif %}
                                                       {% if ex.social_networks %}
                                                       <tr>
                                                            <td class="text-gray-400 py-1 pr-4 whitespace-nowrap">Soc. sítě</td>
                                                            <td class="font-medium text-gray-800">
                                                                 {{ ex.social_networks|nl2br }}
                                                            </td>
                                                       </tr>
                                                       {% endif %}
                                                  </table>
                                                  </div>

                                                  {# Sortiment + Festivaly #}
                                                  <div>
                                                  <h4 class="font-bold text-[#743a25] uppercase tracking-wide text-xs mb-3">
                                                       Sortiment
                                                  </h4>
                                                  <p class="text-gray-700 mb-5 leading-relaxed">
                                                       {{ ex.sortiment }}
                                                  </p>

                                                  <h4 class="font-bold text-[#743a25] uppercase tracking-wide text-xs mb-3">
                                                       Vybrané festivaly
                                                  </h4>
                                                  {% if ex.festival_ids %}
                                                       {% set fids        = ex.festival_ids|split(',') %}
                                                       {% set fspaces     = ex.spaces        ? ex.spaces|split(',')        : [] %}
                                                       {% set felecs      = ex.electricities ? ex.electricities|split(',') : [] %}
                                                       {% set fprices     = ex.prices_total  ? ex.prices_total|split(',')  : [] %}

                                                       <div class="space-y-2">
                                                       {% for i, fid in fids %}
                                                            {% for f in festivals %}
                                                                 {% if f.id == fid|trim|number_format(0,'','') %}
                                                                 <div class="border border-[#e89a7a] rounded-lg p-3 bg-white">
                                                                      <div class="font-semibold text-gray-900 text-sm">
                                                                      {{ f.city }} – {{ f.name }}
                                                                      <span class="text-xs text-[#743a25] uppercase ml-1">
                                                                           {{ f.type }}
                                                                      </span>
                                                                      </div>
                                                                      <div class="text-xs text-gray-500 mt-1 flex flex-wrap gap-3">
                                                                      <span>📐 {{ fspaces[i] ?? '—' }}</span>
                                                                      <span>⚡ {{ felecs[i] ?? '—' }}</span>
                                                                      <span class="font-semibold text-[#743a25]">
                                                                           {{ fprices[i] is defined
                                                                                ? fprices[i]|trim|number_format(0, ',', '.')|raw ~ ' Kč'
                                                                                : '—' }}
                                                                      </span>
                                                                      </div>
                                                                 </div>
                                                                 {% endif %}
                                                            {% endfor %}
                                                       {% endfor %}
                                                       </div>
                                                  {% endif %}

                                                  {# Celková cena #}
                                                  <div class="mt-4 flex justify-between items-center
                                                                 bg-[#743a25] text-white rounded-lg px-4 py-2">
                                                       <span class="text-sm font-semibold">Celková cena</span>
                                                       <span class="font-bold">
                                                            {{ ex.total_price|number_format(0, ',', '.') }} Kč
                                                       </span>
                                                  </div>

                                                  {# Meta #}
                                                  <div class="mt-3 text-xs text-gray-400">
                                                       IP: {{ ex.ip_address ?? '—' }} ·
                                                       Registrace: {{ ex.created_at|date('d. m. Y H:i') }}
                                                  </div>

                                                  {# Zneplatnit #}
                                                  <form method="POST"
                                                        action="{{ base_path }}/admin/exhibitor/{{ ex.id }}/invalidate{% if selected_festival %}?festival={{ selected_festival }}{% endif %}"
                                                        class="mt-4"
                                                        onsubmit="return confirm('Opravdu chcete zneplatnit tohoto vystavovatele? Tato akce je nevratna.')">
                                                       <button type="submit"
                                                               class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700
                                                                      text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors">
                                                            🚫 Zneplatnit vystavovatele
                                                       </button>
                                                  </form>
                                                  </div>

                                             </div>
                                        </td>
                                   </tr>

                              {% endfor %}
                              </tbody>

					{# Řádek se sumou #}
					<tfoot>
						<tr class="bg-[#743a25] text-white">
							<td colspan="7" class="px-4 py-3 font-bold text-right">
								{{ t('admin.col_price') }}:
							</td>
							<td class="px-4 py-3 text-right font-black text-lg whitespace-nowrap">
								{{ grandTotal|number_format(0, ',', '.') }}
								Kč
							</td>
							
						</tr>
					</tfoot>
				</table>
			</div>
		{% else %}
			<div class="text-center py-16 text-brand-400">
				<div class="text-4xl mb-3">📭</div>
				<p>{{ t('admin.no_records') }}</p>
			</div>
		{% endif %}
	</div>

{% endblock %}
